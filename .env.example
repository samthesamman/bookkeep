# Copy this file to .env and fill in real values. .env is gitignored.
# Regenerate/rotate anything that has ever been committed or shared.

# JWT signing key AND the key used to encrypt secrets stored in the DB.
# Must be stable across restarts. Generate with: openssl rand -hex 32
BOOKKEEP_SECRET_KEY=

# Postgres password (used by both the db and app services)
POSTGRES_PASSWORD=

# Redis password
REDIS_PASSWORD=

# Hardcover API token (https://hardcover.app account settings)
HARDCOVER_API_TOKEN=

# SMB/CIFS credentials for the media shares.
# Use a read-write account only where writes are actually needed; use the
# read-only account for the Calibre library.
SMB_USER=
SMB_PASSWORD=
SMB_RO_USER=
SMB_RO_PASSWORD=
