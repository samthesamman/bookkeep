# Copy this file to .env and fill in real values. .env is gitignored.
# Regenerate/rotate anything that has ever been committed or shared.

# JWT signing key AND the key used to encrypt secrets stored in the DB.
# Must be stable across restarts. Generate with: openssl rand -hex 32
BOOKKEEP_SECRET_KEY=

# Postgres password (used by both the db and app services)
POSTGRES_PASSWORD=

# Redis password
REDIS_PASSWORD=

# Hardcover API token (https://hardcover.app account settings)
HARDCOVER_API_TOKEN=

# NYT Books API key, for the Best Sellers lists on the Discover page.
# Register an app at https://developer.nytimes.com/ and enable the Books API.
# Leave blank to hide the Discover page.
NYT_BOOKS_API_KEY=

# Google Books API key, used to source book descriptions when enriching library
# metadata (after a download, and the admin "choose source" picker). The keyless
# API is rate-limited almost immediately, so this is effectively required for
# Google Books to contribute anything. Free: create a project at
# https://console.cloud.google.com/, enable "Books API", make an API key.
# Leave blank to fall back to Open Library + Hardcover only.
GOOGLE_BOOKS_API_KEY=

# ISO country for Google Books requests (default US). Without a country Google
# strips the description and cover from volumes it treats as geo-restricted, so
# only change this if US results are wrong for you.
GOOGLE_BOOKS_COUNTRY=US

# SMB/CIFS credentials for the media shares.
# Use a read-write account only where writes are actually needed; use the
# read-only account for the Calibre library.
SMB_USER=
SMB_PASSWORD=
SMB_RO_USER=
SMB_RO_PASSWORD=

# Set to "true" for the retro 90s GeoCities reskin (Comic Sans, starfield,
# marquee, hit counter). Baked in at build time, so run `docker compose build`
# after changing it. Leave as "false" for the normal UI.
GEOCITIES_MODE=false
