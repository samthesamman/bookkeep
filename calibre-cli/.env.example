# Copy to .env and fill in. Never commit the real file.

PUID=1000
PGID=1000
TZ=Etc/UTC

# Optional HTTP basic auth for the GUI — same as linuxserver/calibre's own
# PASSWORD variable. Leave blank for none.
PASSWORD=

# Your EXISTING linuxserver/calibre /config directory — reuse it directly so
# this container comes up with the same library, users, and settings.
CALIBRE_CONFIG_HOST_PATH=/path/to/existing/calibre/config

# Content Server auth. Leave both blank until you've enabled the Content
# Server from Calibre's own Preferences GUI (see README's first-run step) —
# this isn't something set from outside the container.
CALIBRE_SERVER_USERNAME=
CALIBRE_SERVER_PASSWORD=

# Only needed if you end up hosting more than one library.
CALIBRE_LIBRARY_ID=

# Shared secret bookkeep sends as the X-Api-Key header. Generate one with:
#   openssl rand -hex 32
AGENT_API_KEY=
